{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "smoke:acquire": "NODE_EXTRA_CA_CERTS=../infra/certs/rootCA.pem node scripts/smoke-wallet.mjs acquire",
    "smoke:present": "NODE_EXTRA_CA_CERTS=../infra/certs/rootCA.pem node scripts/smoke-wallet.mjs present",
    "reset": "node scripts/reset-demo.mjs"
  },
  "dependencies": {
    "next": "16.4.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "typescript": "^5",
    "vitest": "5.0.4"
  },
  "packageManager": "pnpm@11.21.0"
}
